<UserControl x:Class="GeosangHub.JeonExchangePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180" MaxWidth="320">
    <Border Background="#F4EFEB" BorderBrush="#D5C8BE" BorderThickness="1" CornerRadius="7" Padding="10">
        <StackPanel>
            <TextBlock Text="지전 현금가 환산" FontSize="16" FontWeight="Bold" Foreground="#302925"/>
            <TextBlock Text="지전과 현금 중 어느 쪽이든 입력할 수 있어요." FontSize="10" Foreground="#806B60" Margin="0,2,0,10"/>

            <Border Background="#FFFDFC" BorderBrush="#CFC2B9" BorderThickness="1" CornerRadius="5" Padding="8">
                <StackPanel>
                    <TextBlock Text="지전 비율" FontSize="10" Foreground="#806B60"/>
                    <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="1만원당" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="억" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBox x:Name="RateInput" Text="3.33333333" TextChanged="RateInput_Changed" Padding="5" MaxLength="18" TextAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#CFC2B9" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock Text="🪙" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="지전" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="억" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <TextBox x:Name="JeonInput" Text="1" TextChanged="JeonInput_Changed" Padding="6" FontSize="18" TextAlignment="Right" MaxLength="20"/>
                        </DockPanel>
                        <TextBlock x:Name="JeonDetailText" Text="1억원" FontSize="10" Foreground="#806B60" TextAlignment="Right" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="⇅" FontSize="22" FontWeight="Bold" Foreground="#8B6B5E" HorizontalAlignment="Center" Margin="0,3" ToolTip="어느 쪽이든 입력하면 반대쪽이 자동 계산됩니다."/>

            <Border Background="White" BorderBrush="#CFC2B9" BorderThickness="1" CornerRadius="6" Padding="9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock Text="₩" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="현금" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="원" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <TextBox x:Name="CashInput" Text="3000" TextChanged="CashInput_Changed" Padding="6" FontSize="18" TextAlignment="Right" MaxLength="24"/>
                        </DockPanel>
                        <TextBlock x:Name="CashDetailText" Text="3,000원" FontSize="10" Foreground="#806B60" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="ValidationText" Foreground="#A23B2A" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
