<Window x:Class="GeosangHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helper="clr-namespace:GeosangHelper"
        xmlns:local="clr-namespace:GeosangHub"
        Title="거상 통합 도우미" Width="1500" Height="950" MinWidth="1050" MinHeight="700"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow" Background="#E8E4E1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="58*" MinHeight="260"/>
            <RowDefinition Height="7"/>
            <RowDefinition x:Name="BottomRow" Height="42*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="4,4,4,0" Background="White" BorderBrush="#77655D" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Background="#302925" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="◀" Click="BrowserBack_Click" ToolTip="뒤로"/>
                    <Button DockPanel.Dock="Left" Content="▶" Click="BrowserForward_Click" ToolTip="앞으로"/>
                    <Button DockPanel.Dock="Left" Content="⌂" Click="BrowserHome_Click" ToolTip="홈"/>
                    <Button DockPanel.Dock="Left" Content="홈 설정" Click="BrowserHomeSettings_Click" ToolTip="새 탭과 홈 버튼의 주소 설정"/>
                    <Button DockPanel.Dock="Right" Content="이동" Click="BrowserGo_Click"/>
                    <Button DockPanel.Dock="Right" Content="새로고침" Click="BrowserRefresh_Click"/>
                    <Button DockPanel.Dock="Right" Content="＋" Click="BrowserZoomIn_Click" ToolTip="인터넷 화면 확대"/>
                    <TextBlock x:Name="BrowserZoomText" DockPanel.Dock="Right" Width="54" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                    <Button DockPanel.Dock="Right" Content="－" Click="BrowserZoomOut_Click" ToolTip="인터넷 화면 축소"/>
                    <TextBox x:Name="BrowserAddress" Margin="6,3" KeyDown="BrowserAddress_KeyDown" Foreground="#2B2522"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Background="#D7CCC5" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="＋ 새 탭" Click="BrowserNewTab_Click" Height="29" Padding="8,2" Margin="2"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BrowserTabItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5,5,0,0" Margin="2,2,0,0" Padding="2" BorderBrush="#A8968C" BorderThickness="1,1,1,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#BDAFA7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="White"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Title}" Click="BrowserTab_Click" ToolTip="{Binding Url}" MinWidth="95" MaxWidth="180" Height="25" Padding="6,1" Margin="0" BorderThickness="0" Background="Transparent"/>
                                            <Button Content="×" Click="BrowserTabClose_Click" Width="24" Height="24" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" ToolTip="탭 닫기"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <DockPanel Grid.Row="2" Background="#F3ECE7" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="북마크" Margin="10,0,4,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button DockPanel.Dock="Right" Content="현재 페이지 추가 ★" Click="BookmarkAdd_Click" Height="28" Padding="7,1" Margin="2"/>
                    <ItemsControl x:Name="BookmarkItems" Margin="2,1" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="BookmarkTile_Click" ToolTip="{Binding Url}" Padding="4,1" MinWidth="58" MaxWidth="105" Height="28" Margin="1">
                                        <Button.ContextMenu>
                                            <ContextMenu Opened="BookmarkContextMenu_Opened">
                                                <MenuItem Header="이름 변경" Click="BookmarkRenameMenu_Click"/>
                                                <Separator/>
                                                <MenuItem Header="왼쪽으로 이동" Click="BookmarkMoveLeftMenu_Click"/>
                                                <MenuItem Header="오른쪽으로 이동" Click="BookmarkMoveRightMenu_Click"/>
                                                <Separator/>
                                                <MenuItem Header="삭제" Click="BookmarkDeleteMenu_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="17" Height="17" Margin="0,0,4,0">
                                                <TextBlock Text="🌐" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconUrl}" Width="14" Height="14" Stretch="Uniform"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="68" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <Grid x:Name="BrowserViewsHost" Grid.Row="3" Background="White" ClipToBounds="True"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" Background="#7B6257"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

        <Grid Grid.Row="2" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HelperColumn" Width="34*" MinWidth="280"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition x:Name="MarketColumn" Width="43*" MinWidth="360"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition x:Name="EmptyColumn" Width="23*" MinWidth="170"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#77655D" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Background="#302925">
                        <Button DockPanel.Dock="Right" Content="＋" Click="HelperZoomIn_Click"/>
                        <TextBlock x:Name="HelperZoomText" DockPanel.Dock="Right" Width="54" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                        <Button DockPanel.Dock="Right" Content="－" Click="HelperZoomOut_Click"/>
                        <TextBlock Text="거상 도우미 · 주막 타이머와 체크리스트" Foreground="White" FontSize="17" FontWeight="Bold" Margin="12,9"/>
                    </DockPanel>
                    <Grid x:Name="HelperViewport" Grid.Row="1" ClipToBounds="True" SizeChanged="HelperViewport_SizeChanged">
                        <helper:GeosangHelperPane x:Name="HelperPane" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="#7B6257"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#77655D" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#302925">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="＋" Click="MarketZoomIn_Click"/>
                            <TextBlock x:Name="MarketZoomText" DockPanel.Dock="Right" Width="54" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            <Button DockPanel.Dock="Right" Content="－" Click="MarketZoomOut_Click"/>
                            <TextBlock Text="거타 육의전 · 원본 페이지" Foreground="White" FontSize="17" FontWeight="Bold" Margin="12,9"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ServerCombo" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="3" Padding="5"/>
                        <TextBox x:Name="MarketSearchBox" Grid.Column="1" KeyDown="MarketSearchBox_KeyDown" ToolTip="아이템 이름"/>
                        <ComboBox x:Name="MarketSortCombo" Grid.Column="2" Margin="3" Padding="5" SelectionChanged="MarketSortCombo_SelectionChanged">
                            <ComboBoxItem Tag="Latest">기본 정렬</ComboBoxItem>
                            <ComboBoxItem Tag="PriceLow">가격 낮은순</ComboBoxItem>
                            <ComboBoxItem Tag="PriceHigh">가격 높은순</ComboBoxItem>
                        </ComboBox>
                        <Button Grid.Column="3" Content="검색" Click="MarketSearch_Click"/>
                    </Grid>
                    <wv2:WebView2 x:Name="MarketView" Grid.Row="2"/>
                    <DockPanel Grid.Row="3" Background="#F4EEE9">
                        <Button DockPanel.Dock="Left" Content="◀ 이전" Click="MarketPrevious_Click"/>
                        <TextBlock x:Name="MarketPageText" DockPanel.Dock="Left" Width="80" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button DockPanel.Dock="Left" Content="다음 ▶" Click="MarketNext_Click"/>
                        <Button DockPanel.Dock="Right" Content="새로고침" Click="MarketRefresh_Click"/>
                        <TextBlock x:Name="MarketStatus" Text="준비 중" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6E5047"/>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" Background="#7B6257"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <Border Grid.Column="4" Background="#F8F6F4" BorderBrush="#77655D" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#302925">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="＋" Click="EmptyZoomIn_Click"/>
                            <TextBlock x:Name="EmptyZoomText" DockPanel.Dock="Right" Width="54" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            <Button DockPanel.Dock="Right" Content="－" Click="EmptyZoomOut_Click"/>
                            <TextBlock Text="도구" Foreground="White" FontSize="17" FontWeight="Bold" Margin="12,9"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RightContent" Margin="5">
                            <local:CalculatorPane x:Name="Calculator" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="이미지 바로가기" Foreground="#5C4338" FontWeight="Bold" Margin="4,15,4,6"/>
                            <ItemsControl x:Name="ImageShortcutButtons">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OpenImageShortcut_Click" MinHeight="38" Margin="0,0,0,5" Padding="7,4" Background="#E9DCD3" BorderBrush="#BCA698" ToolTip="{Binding ImagePath}">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" Foreground="#302925"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="버튼은 왼쪽 환경설정에서 추가할 수 있어요." Foreground="#806B60" FontSize="11" TextWrapping="Wrap" Margin="3,4,3,8"/>
                        </StackPanel>
                    </ScrollViewer>
                    <local:CpuTemperaturePane x:Name="CpuTemperature" Grid.Row="2" Margin="4,3,4,4"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
