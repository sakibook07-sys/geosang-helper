<UserControl x:Class="GeosangHub.CalculatorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150" MaxWidth="280" PreviewKeyDown="Calculator_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="KeyStyle" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#302925"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CFC2B9"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="OperatorStyle" TargetType="Button" BasedOn="{StaticResource KeyStyle}">
            <Setter Property="Background" Value="#E9DCD3"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#F4EFEB" BorderBrush="#D5C8BE" BorderThickness="1" CornerRadius="7" Padding="7">
        <StackPanel>
            <TextBlock x:Name="ExpressionText" Height="23" TextAlignment="Right" Foreground="#806B60" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Border Background="White" BorderBrush="#CFC2B9" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,8">
                <TextBlock x:Name="DisplayText" Text="0" TextAlignment="Right" FontSize="25" FontWeight="Bold"
                           Foreground="#302925" TextTrimming="CharacterEllipsis" ToolTip="현재 계산 결과"/>
            </Border>
            <UniformGrid Columns="4" Rows="5">
                <Button Content="C" Tag="C" Style="{StaticResource OperatorStyle}" Click="Key_Click" ToolTip="전체 지우기"/>
                <Button Content="CE" Tag="CE" Style="{StaticResource OperatorStyle}" Click="Key_Click" ToolTip="현재 숫자 지우기"/>
                <Button Content="⌫" Tag="BACK" Style="{StaticResource OperatorStyle}" Click="Key_Click" ToolTip="한 자리 지우기"/>
                <Button Content="÷" Tag="/" Style="{StaticResource OperatorStyle}" Click="Key_Click"/>

                <Button Content="7" Tag="7" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="8" Tag="8" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="9" Tag="9" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="×" Tag="*" Style="{StaticResource OperatorStyle}" Click="Key_Click"/>

                <Button Content="4" Tag="4" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="5" Tag="5" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="6" Tag="6" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="−" Tag="-" Style="{StaticResource OperatorStyle}" Click="Key_Click"/>

                <Button Content="1" Tag="1" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="2" Tag="2" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="3" Tag="3" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="+" Tag="+" Style="{StaticResource OperatorStyle}" Click="Key_Click"/>

                <Button Content="±" Tag="SIGN" Style="{StaticResource OperatorStyle}" Click="Key_Click" ToolTip="부호 변경"/>
                <Button Content="0" Tag="0" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="." Tag="." Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                <Button Content="=" Tag="=" Style="{StaticResource OperatorStyle}" Click="Key_Click"/>
            </UniformGrid>
            <TextBlock Text="키보드 숫자와 사칙연산도 사용할 수 있어요" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="11" Foreground="#806B60" Margin="0,7,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
