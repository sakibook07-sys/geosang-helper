<UserControl x:Class="GeosangHub.CpuTemperaturePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150" MaxWidth="280">
    <Border Background="#F4EFEB" BorderBrush="#D5C8BE" BorderThickness="1" CornerRadius="7" Padding="8">
        <StackPanel>
            <TextBlock Text="CPU 온도" FontSize="16" FontWeight="Bold" Foreground="#302925"/>
            <TextBlock x:Name="CpuNameText" Text="CPU 센서를 찾는 중..." Foreground="#806B60" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
            <TextBlock x:Name="TemperatureText" Text="-- °C" FontSize="31" FontWeight="Bold" Foreground="#302925"/>
            <TextBlock x:Name="MainSensorText" Text="" Foreground="#5C4338" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Text="센서 준비 중" Foreground="#806B60" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <ItemsControl x:Name="SensorList" Margin="0,7,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Temperature}" FontWeight="SemiBold" Foreground="#302925"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Foreground="#5C4338"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
