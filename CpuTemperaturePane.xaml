<UserControl x:Class="GeosangHub.CpuTemperaturePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150">
    <Border Background="#F4EFEB" BorderBrush="#D5C8BE" BorderThickness="1" CornerRadius="5" Padding="7,5">
        <DockPanel LastChildFill="True">
            <TextBlock x:Name="TemperatureText" DockPanel.Dock="Right" Text="-- °C" FontSize="18" FontWeight="Bold"
                       Foreground="#302925" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CPU 온도" FontSize="12" FontWeight="Bold" Foreground="#302925"/>
                <TextBlock x:Name="StatusText" Text="센서 준비 중" FontSize="10" Foreground="#806B60"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
