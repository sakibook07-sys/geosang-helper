<UserControl x:Class="GeosangHub.JeonRateCalculatorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Border Background="#F4EFEB" BorderBrush="#D5C8BE" BorderThickness="1" CornerRadius="7" Padding="9">
        <StackPanel>
            <TextBlock Text="지전비율 계산기" FontSize="16" FontWeight="Bold" Foreground="#302925"/>
            <TextBlock Text="1억 지전당 현금가" Foreground="#806B60" Margin="0,9,0,3"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="원" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBox x:Name="RateInput" Text="3000" MaxLength="16" TextChanged="InputChanged" Padding="5"/>
            </DockPanel>
            <TextBlock Text="아이템 가격" Foreground="#806B60" Margin="0,9,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PriceInput" Text="1" MaxLength="20" TextChanged="InputChanged" Padding="5"/>
                <ComboBox x:Name="UnitCombo" Grid.Column="1" Margin="5,0,0,0" SelectionChanged="InputChanged" DisplayMemberPath="Name" Padding="3"/>
            </Grid>
            <Border Background="White" BorderBrush="#CFC2B9" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="아이템 가격" Foreground="#806B60" FontSize="11"/>
                    <TextBlock x:Name="FormattedPriceText" Text="1억원" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <TextBlock Text="예상 현금가" Foreground="#806B60" FontSize="11"/>
                    <TextBlock x:Name="CashPriceText" Text="3,000원" FontSize="22" FontWeight="Bold" Foreground="#8B3F2F" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ValidationText" Foreground="#A23B2A" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
