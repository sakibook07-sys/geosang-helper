<UserControl x:Class="GeosangHub.SecondaryBrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#302925" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="◀" Click="Back_Click" ToolTip="뒤로"/>
            <Button DockPanel.Dock="Left" Content="▶" Click="Forward_Click" ToolTip="앞으로"/>
            <Button DockPanel.Dock="Left" Content="⌂" Click="Home_Click" ToolTip="홈"/>
            <Button DockPanel.Dock="Left" Content="홈 설정" Click="HomeSettings_Click" ToolTip="이 인터넷 창의 홈 주소 설정"/>
            <Button DockPanel.Dock="Right" Content="이동" Click="Go_Click"/>
            <Button DockPanel.Dock="Right" Content="새로고침" Click="Refresh_Click"/>
            <Button DockPanel.Dock="Right" Content="＋" Click="ZoomIn_Click" ToolTip="인터넷 화면 확대"/>
            <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Width="54" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="－" Click="ZoomOut_Click" ToolTip="인터넷 화면 축소"/>
            <TextBox x:Name="AddressBox" Margin="6,3" KeyDown="AddressBox_KeyDown" Foreground="#2B2522"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Background="#D7CCC5" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="＋ 새 탭" Click="NewTab_Click" Height="29" Padding="8,2" Margin="2"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TabItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="5,5,0,0" Margin="2,2,0,0" Padding="2"
                                    BorderBrush="#A8968C" BorderThickness="1,1,1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BDAFA7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Title}" Click="Tab_Click" ToolTip="{Binding Url}"
                                            MinWidth="80" MaxWidth="150" Height="25" Padding="6,1" Margin="0"
                                            BorderThickness="0" Background="Transparent"/>
                                    <Button Content="×" Click="TabClose_Click" Width="24" Height="24" Padding="0"
                                            Margin="0" BorderThickness="0" Background="Transparent" ToolTip="탭 닫기"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="2" Background="#F3ECE7" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Margin="6,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="북마크" FontSize="11" TextAlignment="Center" FontWeight="Bold"/>
                <Button Content="★" Click="BookmarkAdd_Click" Width="24" Height="20" FontSize="13"
                        Padding="0" Margin="0" ToolTip="현재 페이지를 북마크에 추가"/>
            </StackPanel>
            <ItemsControl x:Name="BookmarkItems" Margin="2,1" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Bookmark_Click" ToolTip="{Binding Url}" Padding="4,1"
                                MinWidth="58" MaxWidth="105" Height="28" Margin="1">
                            <Button.ContextMenu>
                                <ContextMenu Opened="BookmarkContextMenu_Opened">
                                    <MenuItem Header="이름 변경" Click="BookmarkRename_Click"/>
                                    <Separator/>
                                    <MenuItem Header="왼쪽으로 이동" Click="BookmarkMoveLeft_Click"/>
                                    <MenuItem Header="오른쪽으로 이동" Click="BookmarkMoveRight_Click"/>
                                    <Separator/>
                                    <MenuItem Header="삭제" Click="BookmarkDelete_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="17" Height="17" Margin="0,0,4,0">
                                    <TextBlock Text="🌐" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding IconUrl}" Width="14" Height="14" Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" MaxWidth="68" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <Grid x:Name="ViewsHost" Grid.Row="3" Background="White" ClipToBounds="True"/>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="준비 중" Background="#F4EEE9"
                   Foreground="#6E5047" Padding="6,2" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
