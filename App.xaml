<Application x:Class="GeosangHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AppTextBrush" Color="#321E18"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6E5047"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#47FFF9F2"/>
        <SolidColorBrush x:Key="CardBrush" Color="#75FFF9F4"/>
        <sys:Double x:Key="BaseFontSize">14</sys:Double>
        <sys:Double x:Key="HeadingFontSize">18</sys:Double>
        <sys:Double x:Key="SmallFontSize">11</sys:Double>
        <sys:Double x:Key="TimerFontSize">16</sys:Double>
        <FontFamily x:Key="AppFontFamily">맑은 고딕</FontFamily>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="#E9F5ECE7"/>
            <Setter Property="BorderBrush" Value="#9B6655"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="#F2FFFFFF"/>
            <Setter Property="BorderBrush" Value="#9B6655"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Application.Resources>
</Application>
